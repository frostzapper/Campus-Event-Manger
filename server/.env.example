# -----------------------------------------------------------------------
# Campus Event Finder - server environment
# Copy this file to server/.env and fill in real values.
# Never commit server/.env.
# -----------------------------------------------------------------------

# PostgreSQL connection string (required).
# Adjust user, password, host, port, and database name to match your setup.
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/campus_events"

# TCP port the API server listens on (optional, defaults to 3000).
API_PORT=3000

# Secret used to sign and verify JWTs (required in non-test environments).
# Must be at least 32 characters. Use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret-minimum-32-chars"

# Application environment: development | test | production (optional, defaults to production).
# Set to 'development' for local development to enable stack traces in error responses.
NODE_ENV=development
