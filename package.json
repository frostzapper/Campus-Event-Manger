{
  "name": "campus-event-finder",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:client": "npm run test --workspace=client",
    "test:server": "npm run test --workspace=server",
    "test:shared": "npm run test --workspace=shared",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev": "concurrently --kill-others-on-fail \"npm run dev --workspace=server\" \"npm run dev --workspace=client\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "tar": "^7.5.22",
    "qs": "^6.16.0",
    "chokidar": "^4.0.3"
  }
}
