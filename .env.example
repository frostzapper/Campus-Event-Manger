# PostgreSQL (required for API server)
# Example local URL — adjust user, password, host, port, database name
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_event_finder?schema=public"

# API server (optional — defaults shown)
API_PORT=3000

# JWT signing secret — MUST be a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret"

# Dev/test only: allow `Authorization: Bearer <raw-user-id>` without JWT (never enable in production)
# AUTH_RAW_BEARER_IDS=true
